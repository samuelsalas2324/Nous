# Copia a .env.local para desarrollo (vercel dev). NUNCA subas .env.local a Git.
# En producción, define estas mismas variables en Vercel: Settings → Environment Variables.

# ── Servidor (api/chat.js) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: dominios permitidos separados por coma
ALLOWED_ORIGINS=https://tu-dominio.vercel.app

# ── Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web) ──
# Estos valores son públicos por diseño (van en el navegador); la seguridad está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Comercial (opcional) ─────────────────────────────────────────────────
# WhatsApp del equipo comercial, formato internacional sin "+" (ej. 573001234567). Si falta, el CTA usa el correo.
VITE_WHATSAPP_NUMBER=
# Código de país que se antepone a teléfonos locales de 10 dígitos
VITE_DEFAULT_COUNTRY_CODE=57
# Enlace a la política de tratamiento de datos (se muestra junto al consentimiento del registro)
VITE_PRIVACY_URL=
