# Configuración FALSA para desarrollo contra los emuladores de Firebase (pnpm dev:emu). No contiene secretos.
VITE_FIREBASE_API_KEY=demo-emulator-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nous.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nous
VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
VITE_FIREBASE_EMULATORS=true
